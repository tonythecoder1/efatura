# Copia este ficheiro para .env e preenche a chave no teu computador.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
# Opcional para uso local. Se definida, exige X-API-Key nos endpoints de faturas.
API_KEY=
CSV_PATH=data/faturas.csv
MAX_UPLOAD_MB=20
MAX_PAGES=30
OPENAI_TIMEOUT_SECONDS=120
# Origens do frontend separadas por vírgulas (usado pelo CORS da API).
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
